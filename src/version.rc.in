  BEGIN
   VALUE "FileDescription", "Twitch Dock Themes"
   VALUE "FileVersion", "@PROJECT_VERSION@"
   VALUE "ProductName", "Twitch Dock Themes"
   VALUE "ProductVersion", "@PROJECT_VERSION@"
  END
 END
 BLOCK "VarFileInfo"
